# Server only. Never prefix secrets with VITE_. Bun loads .env automatically.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini
# Higher threshold ignores quieter sounds; longer silence allows thinking pauses.
OPENAI_VOICE_THRESHOLD=0.7
OPENAI_VOICE_SILENCE_MS=1000
# near_field for a close microphone/headset; far_field for a distant laptop mic.
OPENAI_VOICE_NOISE_REDUCTION=near_field
# Optional for local use; required with a public HOST. Share separately with students.
BIGSIGNAL_TUTOR_TOKEN=
HOST=127.0.0.1
PORT=8787
# Exact browser origins, comma separated. Set for your deployed HTTPS origin.
# APP_ORIGIN=https://your-school.example
