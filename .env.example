# Server only. Never prefix secrets with VITE_. Bun loads .env automatically.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VOICE_MODEL=gpt-realtime-2.1
# Optional for local use; required with a public HOST. Share separately with students.
BIGSIGNAL_TUTOR_TOKEN=
HOST=127.0.0.1
PORT=8787
# Exact browser origins, comma separated. Set for your deployed HTTPS origin.
# APP_ORIGIN=https://your-school.example
